{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data for both customers and providers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "provider"] },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "location": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "fullName", "role", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A task request posted by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "providerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "assigned", "in-progress", "completed", "cancelled"] },
        "location": { "type": "string" },
        "date": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "customerId", "title", "description", "category", "budget", "status", "location", "date", "createdAt", "updatedAt"]
    },
    "ProductService": {
      "title": "Product or Service",
      "description": "A service or product offered by a provider",
      "type": "object",
      "properties": {
        "providerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["service", "product"] },
        "createdAt": { "type": "number" }
      },
      "required": ["providerId", "name", "description", "price", "createdAt"]
    },
    "ServiceRating": {
      "title": "Service Rating",
      "description": "Customer rating for a service or product",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string" },
        "providerId": { "type": "string" },
        "rating": { "type": "number" },
        "reviewerName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["serviceId", "providerId", "rating", "reviewerName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Task records"
    },
    "/products_services/{serviceId}": {
      "schema": "ProductService",
      "description": "Published services and products"
    },
    "/service_ratings/{ratingId}": {
      "schema": "ServiceRating",
      "description": "Service reviews and star ratings"
    }
  }
}
