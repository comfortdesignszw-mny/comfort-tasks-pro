rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.customerId;
    }

    function isProvider(taskId) {
      return isAuthenticated() && request.auth.uid == resource.data.providerId;
    }
    
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role', 'createdAt']) &&
             data.id == userId &&
             data.email is string &&
             data.fullName is string && data.fullName.size() < 100 &&
             data.role in ['customer', 'provider'] &&
             data.createdAt is number;
    }
    
    function isValidTask(data, taskId) {
      return data.keys().hasAll(['id', 'customerId', 'title', 'description', 'category', 'budget', 'status', 'location', 'date', 'createdAt', 'updatedAt']) &&
             data.id == taskId &&
             data.customerId is string &&
             data.title is string && data.title.size() < 200 &&
             data.description is string && data.description.size() < 2000 &&
             data.category is string &&
             data.budget is number && data.budget >= 0 &&
             data.status in ['open', 'pending_approval', 'assigned', 'in-progress', 'completed', 'cancelled'] &&
             data.location is string &&
             data.date is number &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidService(data) {
      return data.keys().hasAll(['providerId', 'name', 'description', 'price', 'createdAt']) &&
             data.providerId is string &&
             data.name is string && data.name.size() < 200 &&
             data.description is string && data.description.size() < 2000 &&
             data.price is number && data.price >= 0 &&
             data.createdAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, userId);
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.status == 'open' || 
        resource.data.customerId == request.auth.uid || 
        resource.data.providerId == request.auth.uid ||
        resource.data.acceptedByProviderId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid && isValidTask(request.resource.data, taskId);
      allow update: if isAuthenticated() && (
        // Owner can update anything
        (resource.data.customerId == request.auth.uid && isValidTask(request.resource.data, taskId)) ||
        // Provider can only update status if assigned
        (resource.data.providerId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         request.resource.data.status in ['in-progress', 'completed']) ||
        // Provider can "accept" (pending_approval) if it's open
        (resource.data.status == 'open' && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'acceptedByProviderId', 'acceptedByProviderName']) &&
         request.resource.data.status == 'pending_approval' &&
         request.resource.data.acceptedByProviderId == request.auth.uid) ||
        // Anyone can "assign" themselves if it's open (legacy, keeping for compatibility but pending_approval is preferred)
        (resource.data.status == 'open' && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerId', 'status', 'updatedAt', 'acceptedByProviderId', 'acceptedByProviderName', 'isAccepted']) &&
         request.resource.data.status == 'assigned' &&
         request.resource.data.acceptedByProviderId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid && resource.data.status == 'open';
    }

    match /products_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.providerId == request.auth.uid && isValidService(request.resource.data);
      allow update: if isAuthenticated() && resource.data.providerId == request.auth.uid && isValidService(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.providerId == request.auth.uid;
    }

    match /service_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
    }
  }
}
